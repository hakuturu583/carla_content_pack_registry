from os import PathLike
from typing import Any

__version__: str

class CarlaPackError(Exception):
    """args = (message, code, status)"""

class Client:
    def __init__(self, registry_url: str, token: str | None = None) -> None: ...
    @property
    def registry_url(self) -> str: ...
    def cli_config(self) -> dict[str, Any]: ...
    def me(self) -> dict[str, Any]: ...
    def list_buckets(self) -> list[dict[str, Any]]: ...
    def get_bucket(self, id: str) -> dict[str, Any]: ...
    def resolve_bucket(self, reference: str) -> dict[str, Any]: ...
    def create_bucket(self, body: dict[str, Any]) -> dict[str, Any]: ...
    def update_bucket(self, id: str, body: dict[str, Any]) -> dict[str, Any]: ...
    def delete_bucket(self, id: str) -> None: ...
    def verify_bucket(self, id: str) -> dict[str, Any]: ...
    def put_credentials(self, id: str, body: dict[str, Any]) -> dict[str, Any]: ...
    def get_acl(self, id: str) -> list[dict[str, Any]]: ...
    def put_acl(self, id: str, entries: list[dict[str, Any]]) -> list[dict[str, Any]]: ...
    def list_objects(self, id: str, prefix: str | None = None, cursor: str | None = None, limit: int = 100) -> dict[str, Any]: ...
    def list_all_objects(self, id: str, prefix: str | None = None) -> list[tuple[str, int]]: ...
    def download(self, id: str, key: str, dest: str | PathLike[str]) -> int: ...

class DeviceFlow:
    def __init__(self, github_url: str, client_id: str) -> None: ...
    def start(self, scope: str) -> dict[str, Any]: ...
    def poll(self, device_code: str) -> tuple[str, str | None, int | None]: ...

def resolve_registry(explicit: str | None = None) -> str: ...
def stored_token(registry: str) -> str | None: ...
def save_login(registry: str, token: str, login: str) -> None: ...
def remove_login(registry: str) -> bool: ...
def config_dir() -> str: ...
