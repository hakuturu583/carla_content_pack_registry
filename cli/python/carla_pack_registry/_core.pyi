from os import PathLike
from typing import Any, Callable

__version__: str

class CarlaPackError(Exception):
    """args = (message, code)"""

class Client:
    def __init__(self, registry: str | None = None, require_auth: bool = True) -> None: ...
    def with_token(self, token: str) -> Client: ...
    @property
    def registry_url(self) -> str: ...
    def cli_config(self) -> dict[str, Any]: ...
    def me(self) -> dict[str, Any]: ...
    def list_buckets(self) -> list[dict[str, Any]]: ...
    def resolve_bucket(self, reference: str) -> dict[str, Any]: ...
    def create_bucket(self, body: dict[str, Any]) -> dict[str, Any]: ...
    def update_bucket(self, id: str, body: dict[str, Any]) -> dict[str, Any]: ...
    def delete_bucket(self, id: str) -> None: ...
    def verify_bucket(self, id: str) -> dict[str, Any]: ...
    def put_credentials(self, id: str, body: dict[str, Any]) -> dict[str, Any]: ...
    def get_acl(self, id: str) -> list[dict[str, Any]]: ...
    def update_acl(
        self, id: str, mode: str, users: list[str] = ..., orgs: list[str] = ..., teams: list[str] = ...
    ) -> list[dict[str, Any]]: ...
    def list_objects(self, id: str, prefix: str | None = None) -> list[dict[str, Any]]: ...
    def pull(
        self,
        id: str,
        targets: list[str],
        out_dir: str | PathLike[str],
        force: bool = False,
        jobs: int = 4,
        on_event: Callable[[dict[str, Any]], None] | None = None,
    ) -> int: ...
    def install_pack(
        self,
        id: str,
        key: str,
        packs_dir: str | PathLike[str],
        base_release: str | None = None,
        force: bool = False,
    ) -> dict[str, Any]: ...

def device_login(client_id: str, scope: str, on_code: Callable[[str, str], None]) -> str: ...
def bucket_ref(bucket: dict[str, Any]) -> str: ...
def save_login(registry: str, token: str, login: str) -> None: ...
def remove_login(registry: str | None = None) -> tuple[str, bool]: ...
